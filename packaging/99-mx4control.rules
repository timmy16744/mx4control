# udev rules for MX4Control - Logitech MX Master 4 access

# Logitech USB devices - HID raw access
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", MODE="0666", TAG+="uaccess"

# Logitech Bolt receiver
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c548", MODE="0666", TAG+="uaccess"

# MX Master 4 via Bolt
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="b042", MODE="0666", TAG+="uaccess"

# MX Master 4 via Bluetooth
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="4107", MODE="0666", TAG+="uaccess"
